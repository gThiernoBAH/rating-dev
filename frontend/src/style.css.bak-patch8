/* =========================================================================
   EVALPOINT -- Design tokens (alignes sur vusine-dev : fond clair, bleu
   SIVOP, Inter, rayons 10/16, ombre carte douce, cible tactile 48px).
   ========================================================================= */
:root {
  /* Couleurs de marque */
  --color-brand: #1B4D7A;
  --color-brand-dark: #123655;
  --color-brand-light: #E8F0F7;

  /* Surfaces */
  --color-bg: #F4F6F9;
  --color-surface: #FFFFFF;
  --color-border: #E2E8F0;

  /* Texte */
  --color-text: #1A202C;
  --color-text-muted: #64748B;
  --color-text-inverse: #FFFFFF;

  /* Statuts */
  --color-vert: #16A34A;
  --color-vert-bg: #DCFCE7;
  --color-orange: #D97706;
  --color-orange-bg: #FEF3C7;
  --color-rouge: #DC2626;
  --color-rouge-bg: #FEE2E2;
  --color-arret: #475569;
  --color-arret-bg: #E2E8F0;

  /* Typographie */
  --font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --font-size-xs: 0.75rem;
  --font-size-sm: 0.875rem;
  --font-size-base: 1rem;
  --font-size-lg: 1.125rem;
  --font-size-xl: 1.5rem;

  /* Espacement */
  --space-1: 4px;  --space-2: 8px;  --space-3: 12px;
  --space-4: 16px; --space-6: 24px; --space-8: 32px;

  /* Rayons / ombres */
  --radius-md: 10px;
  --radius-lg: 16px;
  --shadow-card: 0 1px 3px rgba(15, 23, 42, 0.08), 0 1px 2px rgba(15, 23, 42, 0.04);

  /* Cible tactile minimale */
  --touch-target-min: 48px;
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; height: 100%; }
body {
  font-family: var(--font-family);
  background: var(--color-bg);
  color: var(--color-text);
  font-size: var(--font-size-base);
  -webkit-font-smoothing: antialiased;
}
#app { height: 100%; }
button { font-family: inherit; }

/* Boutons d'action partages (comme .vbtn vusine) */
.vbtn {
  display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
  border: 1px solid transparent; border-radius: var(--radius-md);
  padding: 6px var(--space-3); font-family: inherit; font-size: var(--font-size-xs);
  font-weight: 700; line-height: 1.2; white-space: nowrap; cursor: pointer;
  transition: transform .15s ease, box-shadow .15s ease, background-color .15s ease;
}
.vbtn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 3px 8px rgba(27, 77, 122, 0.18); }
.vbtn:active:not(:disabled) { transform: translateY(0); box-shadow: none; }
.vbtn:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
.vbtn:disabled { opacity: .55; cursor: not-allowed; }
.vbtn.primary { background: var(--color-brand); color: var(--color-text-inverse); }
.vbtn.primary:hover:not(:disabled) { background: var(--color-brand-dark); }
.vbtn.ghost { background: var(--color-surface); color: var(--color-brand); border-color: var(--color-brand); }
.vbtn.danger { background: var(--color-rouge); color: var(--color-text-inverse); }

/* Statuts partages */
.statut-vert   { color: var(--color-vert);   background: var(--color-vert-bg); }
.statut-orange { color: var(--color-orange); background: var(--color-orange-bg); }
.statut-rouge  { color: var(--color-rouge);  background: var(--color-rouge-bg); }
.statut-arret  { color: var(--color-arret);  background: var(--color-arret-bg); }

/* Variantes vbtn utilisées par ConfirmDialog (comme vusine) */
.vbtn-secondary { background: var(--color-surface); color: var(--color-text); border-color: var(--color-border); }
.vbtn-secondary:hover:not(:disabled) { background: var(--color-bg); box-shadow: none; }
.vbtn-primary { background: var(--color-brand); color: var(--color-text-inverse); }
.vbtn-primary:hover:not(:disabled) { background: var(--color-brand-dark); }
.vbtn-danger { background: var(--color-rouge); color: var(--color-text-inverse); }
.vbtn-danger:hover:not(:disabled) { background: #b91c1c; }

/* PATCH 7 — badge de statut compact (Actif/Inactif, statut campagne) */
.badge-statut { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 11px; font-weight: 700; white-space: nowrap; }

/* =========================================================================
   PATCH 8 — MOBILE (<= 768px) : bottom-sheets, tableaux compacts,
   onglets scrollables. Desktop (> 768px) : aucun impact.
   ========================================================================= */
@media (max-width: 768px) {
  .tabs { overflow-x: auto; flex-wrap: nowrap; -webkit-overflow-scrolling: touch; }
  table.data th, table.data td { padding: 6px 8px; font-size: 12px; }
  .btn { padding: 10px 14px; }
  .modal-bg { align-items: flex-end; }
  .modal {
    width: 100vw; max-width: 100vw;
    max-height: 92vh; overflow: auto;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    padding: var(--space-4);
  }
  .barre-outils { flex-direction: column; align-items: stretch; gap: var(--space-2); }
}

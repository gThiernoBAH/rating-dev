# 2026-10-02 — copier vers .env (JAMAIS versionné ; secrets jamais dans git)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ratingdb_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-moi

# 2026-10-02 — service systemd (convention vusine-dev) : API sur 127.0.0.1:8103
[Unit]
Description=HIF-RATING API (FastAPI)
After=network.target postgresql.service

[Service]
User=www-data
WorkingDirectory=/srv/rating/backend
EnvironmentFile=/srv/rating/backend/.env
ExecStart=/srv/rating/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8103 --workers 2
Restart=always

[Install]
WantedBy=multi-user.target
